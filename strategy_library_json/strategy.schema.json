{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PIMiner lossless strategy export",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "title",
    "source",
    "introduction_markdown",
    "scope",
    "examples",
    "examples_preamble_markdown",
    "extra_sections",
    "source_blocks",
    "warnings",
    "mechanism_distinction",
    "procedure",
    "fingerprint",
    "failure_conditions",
    "initialization_guidance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "enum": [
        "strategy",
        "template"
      ]
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "filename",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "introduction_markdown": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "target_models",
        "user_and_injected_tasks"
      ],
      "additionalProperties": false,
      "properties": {
        "target_models": {
          "$ref": "#/$defs/section"
        },
        "user_and_injected_tasks": {
          "$ref": "#/$defs/section"
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "heading",
          "source_line",
          "target_model",
          "benchmark_case",
          "preamble_markdown",
          "placeholder_context_reference",
          "field_blocks",
          "user_task",
          "injection_goal",
          "placeholder_context",
          "winning_injection_text",
          "result",
          "why_it_worked"
        ],
        "properties": {
          "number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "heading": {
            "type": "string"
          },
          "source_line": {
            "type": "integer",
            "minimum": 1
          },
          "target_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "benchmark_case": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "suite",
              "user_task_id",
              "injection_task_id"
            ],
            "additionalProperties": false,
            "properties": {
              "suite": {
                "type": "string"
              },
              "user_task_id": {
                "type": "string"
              },
              "injection_task_id": {
                "type": "string"
              }
            }
          },
          "preamble_markdown": {
            "type": "string"
          },
          "placeholder_context_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "field_blocks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/field"
            }
          },
          "user_task": {
            "type": [
              "string",
              "null"
            ]
          },
          "injection_goal": {
            "type": [
              "string",
              "null"
            ]
          },
          "placeholder_context": {
            "type": [
              "string",
              "null"
            ]
          },
          "winning_injection_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "type": [
              "string",
              "null"
            ]
          },
          "why_it_worked": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "examples_preamble_markdown": {
      "type": "string"
    },
    "extra_sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "source_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "markdown"
        ],
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": [
              "string",
              "null"
            ]
          },
          "markdown": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mechanism_distinction": {
      "$ref": "#/$defs/section"
    },
    "procedure": {
      "$ref": "#/$defs/section"
    },
    "fingerprint": {
      "$ref": "#/$defs/section"
    },
    "failure_conditions": {
      "$ref": "#/$defs/section"
    },
    "initialization_guidance": {
      "$ref": "#/$defs/section"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "text",
        "markdown"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "heading",
        "markdown"
      ],
      "properties": {
        "heading": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "columns",
              "rows"
            ],
            "additionalProperties": false,
            "properties": {
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "field",
        "label",
        "annotation_markdown",
        "markdown",
        "text",
        "reference_only"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "user_task",
            "injection_goal",
            "placeholder_context",
            "winning_injection_text",
            "result",
            "why_it_worked"
          ]
        },
        "label": {
          "type": "string"
        },
        "annotation_markdown": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_only": {
          "type": "boolean"
        }
      }
    }
  }
}

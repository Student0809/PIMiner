# PIMiner provider keys — copy to `.env` and fill in.
# The .env file is loaded by pim_train_parallel.sh / pim_test_parallel.sh and is
# gitignored (never commit real keys). The attacker/router sessions run on the
# Max subscription, so ANTHROPIC_API_KEY is intentionally UNSET by the scripts;
# the keys below are only for the TARGET models being attacked.

# OpenAI targets (gpt-5*, gpt-4*, o*)
OPENAI_API_KEY=

# Anthropic TARGET models (claude-haiku-*, claude-sonnet-*, claude-opus-*).
# Named PIMINER_TARGET_* so it is not confused with the attacker/router auth;
# it is promoted to ANTHROPIC_API_KEY only inside the submit subprocess.
PIMINER_TARGET_ANTHROPIC_API_KEY=

# Google Gemini targets (gemini-2.5-*)
GEMINI_API_KEY=

# DeepSeek targets (deepseek-*)
DEEPSEEK_API_KEY=
